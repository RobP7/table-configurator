# Copy to .env.local for local testing (never commit .env.local).
# In production, set these in Vercel → Project Settings → Environment Variables.

# Your Shopify store's .myshopify.com domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token with the write_draft_orders scope. Obtained via the
# one-time OAuth handshake at /api/shopify-install (see shopify-install.ts
# and shopify-oauth-callback.ts) since the newer Shopify dev dashboard app
# type doesn't expose a plain "reveal token" button. Keep this secret.
SHOPIFY_ADMIN_API_TOKEN=

# Used only by the one-time OAuth handshake above — from the app's
# Credentials page on dev.shopify.com. Delete shopify-install.ts and
# shopify-oauth-callback.ts (and these two vars) once SHOPIFY_ADMIN_API_TOKEN
# is set; they're not needed afterward.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: restrict which origin can call the API (your storefront's URL).
# Defaults to "*" (any origin) if not set.
ALLOWED_ORIGIN=

# Frontend-facing (Vite exposes anything prefixed VITE_ to the browser bundle).
# Where the checkout API lives. Leave unset to use the relative path
# "/api/create-draft-order" (works if this whole app, including /api, is
# deployed together on Vercel). Set to a full URL if the API is hosted
# separately from wherever the configurator's static files are served.
VITE_CHECKOUT_API_URL=
